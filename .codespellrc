[codespell]
skip = ./.git,./target,./reference,./benchmark/perf.data*,./benchmark/*.out,./benchmark/*.svg,./assets,./Cargo.lock
# Intentional typo fixtures for the suggestion-engine test suite - these
# misspellings are deliberate test INPUTS (typo in, "Did you mean?" tip out):
#   speeed / charaset  - config key hint tests (config_hints/tests.rs)
#   afternon / larg / defualt / Defaul - CLI value suggestion tests
#     (cli/suggestion.rs, validation/tests.rs, scene_custom, config_apply)
# Never "correct" these words in the test fixtures - the tests would stop
# exercising the typo-tolerance path they exist to verify.
ignore-words-list = alacritty,cosmostrix,crossterm,katakana,unicode,uptodate,numer,denom,iterm,bu,speeed,charaset,retuned,trough,troughs,statics,pre-emptive,afternon,larg,defualt,Defaul,precess,precesses,precessing,precession
